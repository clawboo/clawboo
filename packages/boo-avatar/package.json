{
  "name": "@clawboo/boo-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic ghost-lobster SVG avatar generator for Clawboo agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clawboo/clawboo.git",
    "directory": "packages/boo-avatar"
  },
  "homepage": "https://github.com/clawboo/clawboo/tree/main/packages/boo-avatar",
  "bugs": "https://github.com/clawboo/clawboo/issues",
  "keywords": [
    "clawboo",
    "avatar",
    "svg",
    "procedural",
    "ghost"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./variants/codex": {
      "types": "./dist/variants/codex.d.ts",
      "import": "./dist/variants/codex.mjs",
      "require": "./dist/variants/codex.js"
    },
    "./variants/claude": {
      "types": "./dist/variants/claude.d.ts",
      "import": "./dist/variants/claude.mjs",
      "require": "./dist/variants/claude.js"
    },
    "./variants/hermes-light": {
      "types": "./dist/variants/hermes-light.d.ts",
      "import": "./dist/variants/hermes-light.mjs",
      "require": "./dist/variants/hermes-light.js"
    },
    "./variants/hermes-dark": {
      "types": "./dist/variants/hermes-dark.d.ts",
      "import": "./dist/variants/hermes-dark.mjs",
      "require": "./dist/variants/hermes-dark.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "generate:artwork": "node scripts/generate-variant-artwork.mjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@clawboo/tsconfig": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
