{
  // The test program: sources + tests together, WITHOUT the main config's
  // `types: []` pin — vitest's type graph may resolve node ambients, which is
  // exactly why tests are excluded from tsconfig.json (see the note there).
  "extends": "@clawboo/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
