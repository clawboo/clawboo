{
  "name": "@clawboo/connector-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "The in-repo, offline-verifiable connector directory: curated MCP server definitions with no network fetch at runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clawboo/clawboo.git",
    "directory": "packages/connector-catalog"
  },
  "homepage": "https://github.com/clawboo/clawboo/tree/main/packages/connector-catalog",
  "bugs": "https://github.com/clawboo/clawboo/issues",
  "keywords": [
    "clawboo",
    "connectors",
    "mcp",
    "catalog"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./community": {
      "types": "./dist/community.d.ts",
      "import": "./dist/community.mjs",
      "require": "./dist/community.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@clawboo/tsconfig": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "zod": "^3.25.0"
  }
}
