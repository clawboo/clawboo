---
/**
 * Final CTA. Was a structural clone of the hero: same sky island (two more
 * client:load React components), same install command with a near-identical
 * caption, same solid Star button, same outline secondary. It is now a quiet
 * closing band that repeats only the one thing worth repeating.
 */
import GitHubStars from '../components/GitHubStars.astro'
import Button from '../components/Button.astro'
import { links } from '../lib/site'
---

<section id="cta" class="section rule relative overflow-hidden">
  <div class="cta-wash" aria-hidden="true"></div>
  <div class="container container-prose relative z-10 text-center">
    <h2 class="d2">A team of agents, running in about a minute.</h2>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <GitHubStars variant="solid" label="Star on GitHub" />
      <Button
        href={links.discussions}
        target="_blank"
        rel="noopener noreferrer"
        variant="secondary"
        size="lg"
        iconRight="arrow-up-right">Ask in Discussions</Button
      >
    </div>
  </div>
</section>

<style>
  .cta-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      52% 60% at 50% 100%,
      rgb(var(--primary-rgb) / 0.09),
      transparent 72%
    );
  }
</style>
