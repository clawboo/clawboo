---
/**
 * Every runtime, one team. Absorbs the old Problem section's argument and two
 * Features cards that repeated this section's own subhead word for word.
 *
 * Corrections carried in from the code audit:
 *  - Native reaches ELEVEN providers, not four (nativeProviders.ts:20-53 is
 *    seven OpenAI-compatible plus four built-in). The old copy said four and
 *    contradicted the FAQ on the same page.
 *  - "Each runtime keeps its own native powers" was false as a universal; it is
 *    true of Hermes and OpenClaw (README.md:78). Said about those two only.
 *  - "Coordination flows over structured lifecycle events and MCP calls, never
 *    terminal-output scraping" is true but unreadable. Said in plain words.
 */
import RuntimeMark from '../components/RuntimeMark.astro'
import { Picture } from 'astro:assets'
import { links } from '../lib/site'
import Icon from '../components/Icon.astro'
import runtimesPanel from '../assets/screenshots/runtimes-panel.png'

const runtimes = [
  {
    name: 'Clawboo Native',
    img: '/logo.svg',
    tagline: 'Built in. Reaches eleven providers — Anthropic, OpenAI, Google, xAI, Groq, Mistral, and more — with one key.',
    chip: 'Built in',
    chipTone: 'mint' as const,
    accent: '#e94560',
    featured: true,
  },
  {
    name: 'Claude Code',
    monogram: 'C',
    tagline: "Anthropic's coding agent.",
    chip: 'Install + connect',
    accent: '#d97757',
  },
  {
    name: 'Codex',
    monogram: 'Cx',
    tagline: "OpenAI's coding agent CLI. One codex login.",
    chip: 'Install + connect',
    accent: '#10a37f',
  },
  {
    name: 'Hermes',
    monogram: 'H',
    tagline: 'Open-source, over OpenRouter. Keeps its own skills and self-improvement.',
    chip: 'Install + connect',
    accent: '#a78bfa',
  },
  {
    name: 'OpenClaw',
    monogram: 'O',
    tagline: 'Connects as a Gateway. Keeps its own channels and always-on presence.',
    chip: 'Connect Gateway',
    accent: '#1f9ec4',
  },
]
---

<section id="runtimes" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">Every runtime, one team</span>
      <h2 class="d2 mt-4">Your best agents don&rsquo;t talk to each other. Now they do.</h2>
      <p class="lead">
        Each one is strong on its own and trapped in its own terminal, with its own memory and no
        record of what the others did. Clawboo gives all five one board, one chat and one memory —
        and any of them can lead.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {runtimes.map((r) => <RuntimeMark {...r} />)}

      <div class="card flex h-full flex-col justify-between">
        <div>
          <h3 class="d3">They hand work over properly</h3>
          <p class="mt-2 text-[14px] leading-relaxed text-secondary">
            Agents coordinate through the board and structured messages, never by reading each
            other&rsquo;s screen output. Each one works in its own copy of the code, so two agents
            can&rsquo;t overwrite each other.
          </p>
        </div>
        <a
          class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium text-primary hover:underline"
          href={links.docs}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the runtimes guide
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>

    <div class="panel mt-12">
      <div class="panel-grid">
        <div>
          <h3 class="d3">Connect one from the dashboard</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-secondary">
            Native is already connected and needs nothing installed. The others take a key or a
            single sign-in, and the panel tells you which is missing.
          </p>
        </div>
        <div class="panel-media">
          <Picture
            src={runtimesPanel}
            alt="The Runtimes panel: Clawboo Native connected, Claude Code and Codex ready to connect, Hermes connected, and an OpenClaw Gateway."
            formats={['avif', 'webp']}
            widths={[720, 1080, 1440, 1920]}
            sizes="(min-width: 900px) 680px, 94vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
