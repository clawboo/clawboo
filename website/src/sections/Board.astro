---
/**
 * What you actually get.
 *
 * Built on the Tines grid: the card IS a cropped piece of the product and the
 * words sit under it. No icon in a tinted rounded square anywhere: that
 * element is the single most generic thing on a SaaS page and none of the
 * references use one.
 *
 * Claims, each checkable in the codebase:
 *  - a race-free claim is one SQL statement (board/repository.ts:365-377)
 *  - promotion to done is GATED on the verification verdict
 *    (board/repository.ts:619-621), not a convention an agent can route around.
 *    Read that gate carefully before restating it: the condition is
 *    `to === 'done' && !opts.humanOverride && !verdictCellPromotable(...)`, so
 *    it is not unconditional. Two server paths pass humanOverride deliberately
 *    (worktrees.ts:332 for an empty diff, openclawDispatch.ts:433 for an
 *    OpenClaw connected-substrate completion, which audits itself as
 *    `unverified: true`). An earlier draft of this page claimed the gate
 *    rejected `-> done` "from any caller", which those two paths falsify.
 *  - one memory tier every runtime reads and writes
 *  - capabilities and spend visible per agent
 */
import ThemedShot from '../components/ThemedShot.astro'
import ThemedLoop from '../components/ThemedLoop.astro'
import sharedMemory from '../assets/screenshots/shared-memory.png'
import agentDetail from '../assets/screenshots/agent-detail.png'
import ghostGraph from '../assets/screenshots/ghost-graph.png'
// All four are `loading="lazy"`, so the hidden variant has no box and should
// never be fetched. That is the cheap half of the theme swap; the hero is the
// half that pays. See the `[data-shot-theme]` note in marketing.css.
import sharedMemoryDark from '../assets/screenshots/shared-memory-dark.png'
import agentDetailDark from '../assets/screenshots/agent-detail-dark.png'
import ghostGraphDark from '../assets/screenshots/ghost-graph-dark.png'

const panels = [
  {
    loop: 'memory-search',
    title: 'One memory, shared',
    body: 'Facts and procedures every runtime on the team can read and write, instead of a private context window per runtime.',
    // The old capture of this panel was empty, so "listing facts and versioned
    // procedures" described a list that was not there. The new one is full and
    // the alt can name what is in it.
    alt: 'The Memory panel being searched: a question is typed, and the shared store ranks the facts that answer it by relevance.',
  },
  {
    loop: 'board-scope',
    title: 'One board, every team',
    body: "Work moves from backlog to done in columns laid out by day, scoped to one team or to all of them at once, with what needs you in today's row.",
    // The board is a calendar: status columns across the top, days down the
    // side, beside the sidebar. The loop ends on a routine's upcoming runs,
    // which are drawn on the days they fire.
    alt: "The board in Week view, scoped to the Growth team with one task that needs you and five in progress, then widened to every team: three tasks that need a person sit in today's row, and a weekday routine's upcoming runs open from Monday.",
  },
  {
    src: agentDetail,
    dark: agentDetailDark,
    title: 'Agents you can open up',
    body: 'Talk to any teammate one to one, with its model, tools and personality on cards beside the chat, editable in place.',
    // Opened from the agent's tile in the sidebar: the 1:1 chat, then the
    // Graph card (model chip, tools, skills, connectors) over the Details
    // card on its Personality tab.
    alt: 'An agent opened up: a one to one chat with Ada in the middle, and beside it her Graph card, with her model chip and the tools and connectors she can reach, over her Details card open on Personality, with its presets and sliders.',
  },
  {
    src: ghostGraph,
    dark: ghostGraphDark,
    title: 'See every team at once',
    body: 'Every team you run on one org chart under Boo Zero, with who is working right now.',
    // The Org chart in its Tree layout, across all three teams.
    alt: "The Org chart in Tree layout: Boo Zero at the top, the Growth, Support and Platform teams beneath it with five, three and three agents running, and each team's Boos in a row under it.",
  },
]
---

<section id="board" class="section band">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">The board</span>
      <h2 class="d2 mt-4">A durable board, with the chat running alongside it.</h2>
      <p class="lead">
        The board is where decisions land and the chat is the narration. Tasks survive restarts,
        two agents can never claim the same one, and a failed verification verdict blocks the move
        to done unless it is explicitly overridden.
      </p>
    </div>

    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2">
      {
        panels.map((p) => (
          <div class="shot-card">
            <figure>
              {
                p.loop ? (
                  <ThemedLoop name={p.loop} alt={p.alt} />
                ) : (
                  <ThemedShot
                    light={p.src}
                    dark={p.dark}
                    alt={p.alt}
                    widths={[560, 840, 1120]}
                    sizes="(min-width: 640px) 520px, 92vw"
                    loading="lazy"
                  />
                )
              }
            </figure>
            <h3 class="d3">{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
