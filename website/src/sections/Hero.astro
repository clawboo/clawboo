---
/**
 * Hero.
 *
 * The sky is the ORIGINAL SignatureSky, restored verbatim from main: two
 * server-rendered SkyAtmosphere islands (day and night, CSS-swapped so there is
 * no flash), each with its drifting BackgroundBoos. It is scoped to a band
 * rather than the viewport so the product screenshot still breaks across its
 * lower edge.
 *
 * The sky is back, rebuilt as a shallow illustrated band (see SkyBand.astro):
 * saturated at the crown, pale by the time it reaches the headline, gone before
 * the page continues. The board screenshot breaks across its lower edge, the
 * way Aside and Deta do it. The overlap is what makes the band read as
 * composed rather than as wallpaper behind unrelated text.
 *
 * The install command's caption and the four trust badges are gone at your
 * request. The install command itself still appears in "See it work" and in the
 * closing CTA.
 */
import { Picture } from 'astro:assets'
import GitHubStars from '../components/GitHubStars.astro'
import Button from '../components/Button.astro'
import SignatureSky from '../components/atmosphere/SignatureSky.astro'
import RuntimeStrip from '../components/RuntimeStrip.astro'
import { links } from '../lib/site'
import teamSpace from '../assets/screenshots/team-space.png'
---

<section id="hero" class="relative overflow-hidden on-sky">
  <div class="sky-band" aria-hidden="true"><SignatureSky /></div>

  <div class="container container-wide relative z-10 pb-16 pt-28 sm:pt-32">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">Open-source · MIT · Local-first</span>

      <h1 class="d1 mt-5">Your coding agents, working as one team.</h1>

      <p class="lead mx-auto mt-5 max-w-xl">
        Claude Code, Codex, Hermes and OpenClaw on one shared board, in one chat, with one memory.
        Native agents are built in, so you can paste a key and start.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <GitHubStars variant="solid" label="Star on GitHub" />
        <Button
          href={links.docs}
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          size="lg"
          iconRight="arrow-up-right"
        >
          Read the docs
        </Button>
      </div>
    </div>

    <RuntimeStrip />

    <!-- The board, at full content width and actually readable. The source is
         2720x1720, so it can carry this size; it was previously rendered at
         300px inside a drawn browser window, 900px down the page. -->
    <figure class="shot mt-12 sm:mt-14">
      <Picture
        src={teamSpace}
        alt="The Clawboo board: a team of agents with tasks moving across todo, in progress and done columns, with the group chat beside it."
        formats={['avif', 'webp']}
        widths={[720, 1080, 1440, 1920, 2400]}
        sizes="(min-width: 1280px) 1200px, 94vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  /* The band scopes the restored full-bleed sky. SignatureSky is absolute
     inset-0, so it fills this wrapper rather than the whole hero. */
  .sky-band {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(30rem, 26rem + 18vw, 46rem);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 96%);
    mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 96%);
  }

  /* The original sky is saturated where the type sits, which is why the old hero
     used a text-shadow halo on every string. Those tokens are still in
     tokens.css, so the restored sky gets the treatment it was designed with. */
  .on-sky :global(.eyebrow),
  .on-sky :global(.lead) {
    color: var(--sky-ink-soft);
    text-shadow: var(--sky-halo-soft);
  }
  .on-sky :global(h1) {
    color: var(--sky-ink);
    text-shadow: var(--sky-halo);
  }
</style>
