---
/**
 * Hero.
 *
 * Positioning: this is NOT a coding tool. The catalogue is 436 agents across
 * categories like agency-agents, growth-marketing, lifecycle-commerce,
 * google-ads-analytics, creator-studio, business-desk and product-craft, and
 * the screenshot below shows a team shipping a pricing page across research,
 * copy, analysis and code, not a room of engineers. The headline
 * used to say "your coding agents", which fought both the product and its own
 * picture. Claude Code, Codex and Hermes are the ENGINES; the agents built on
 * them do any kind of work, so the runtimes are named further down the page
 * rather than in the promise.
 *
 * The sky is the ORIGINAL SignatureSky, restored verbatim from main: two
 * server-rendered SkyAtmosphere islands (day and night, CSS-swapped so there is
 * no flash), each with its drifting BackgroundBoos. It is scoped to a band
 * rather than the viewport so the dashboard breaks across its lower edge.
 *
 * BooSquad sits between the CTAs and the dashboard, where a row of runtime tile
 * buttons used to be. The runtime marks moved out of this section entirely and
 * now head the Runtimes section, in place of its eyebrow text.
 */
import ThemedShot from '../components/ThemedShot.astro'
import GitHubStars from '../components/GitHubStars.astro'
import Button from '../components/Button.astro'
import SignatureSky from '../components/atmosphere/SignatureSky.astro'
import { BooSquad } from '../components/atmosphere/BooSquad.tsx'
import { links } from '../lib/site'
import teamSpace from '../assets/screenshots/team-space.png'
// Two distinct files from here on, which is when the hero starts paying for the
// swap: it is the one `loading="eager"` shot on the page, `display: none`
// cancels no eager fetch in any engine, and the two <picture>s no longer point
// at the same URL for the browser's cache to collapse. Measured cost and the
// single-<picture> way out are in the `[data-shot-theme]` note in marketing.css.
import teamSpaceDark from '../assets/screenshots/team-space-dark.png'
---

<section id="hero" class="relative overflow-hidden on-sky">
  <div class="sky-band" aria-hidden="true"><SignatureSky /></div>

  <div class="container container-wide relative z-10 pb-16 pt-28 sm:pt-32">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">Open-source · MIT · Local-first</span>

      <h1 class="d1 mt-5">Put a whole team of AI agents on it.</h1>

      <p class="lead mx-auto mt-5 max-w-xl">
        Marketing, research, ops, content, code. Give one brief to a team of agents and watch them
        split it up, hand work between each other, and finish it on a board you can see.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <GitHubStars variant="solid" label="Star on GitHub" />
        <Button
          href={links.docs}
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          size="lg"
          iconRight="arrow-up-right"
        >
          Read the docs
        </Button>
      </div>
    </div>

    <!-- The squad, back where the runtime tiles were. -->
    <div class="relative z-10 mt-10 flex w-full justify-center overflow-hidden sm:mt-8">
      <BooSquad client:visible />
    </div>

    <!-- The team space, at full content width and actually readable. The
         capture is wide enough to carry this size; it used to render at 300px
         inside a drawn browser window, 900px down the page.

         The alt text used to describe a board and a group chat in one view.
         That view is not built yet, so the sentence was selling unshipped
         software from the top of the homepage. It now names the three things
         the capture actually contains, in the order they read: the roster, the
         delegation graph, the chat. Nothing about a board, and no task status
         either, because tasks are not what this surface shows. -->
    <figure class="shot mt-10 sm:mt-12">
      <ThemedShot
        light={teamSpace}
        dark={teamSpaceDark}
        alt="The Growth team's space in Clawboo: five agents down the left column with their live status, the delegation graph above showing who handed work to whom, and the group chat below where the lead says where the pricing page stands."
        widths={[720, 1080, 1440, 1920, 2400]}
        sizes="(min-width: 1280px) 1200px, 94vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  /* The band scopes the restored full-bleed sky. SignatureSky is absolute
     inset-0, so it fills this wrapper rather than the whole hero. */
  .sky-band {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(30rem, 26rem + 18vw, 46rem);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 48%, transparent 88%);
    mask-image: linear-gradient(180deg, #000 0%, #000 48%, transparent 88%);
  }

  /* Haze at the zenith. This is here for the nav: its links sit in the most
     saturated part of the gradient and measured 2.83:1 against it, and no
     text colour fixes that (opaque --foreground on that blue is 4.09:1,
     white 4.36:1). Lightening the ground under them is the only lever, and a
     top-down haze is the one that costs the sky nothing: it reads as glare,
     the clouds still run through it, and the nav keeps its transparent state
     instead of wearing a frosted bar from page load. */
  .sky-band::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 11rem;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.62) 0%,
      rgb(255 255 255 / 0.44) 34%,
      rgb(255 255 255 / 0.18) 68%,
      transparent 100%
    );
    pointer-events: none;
  }
  :global(:root.dark) .sky-band::after {
    background: linear-gradient(
      180deg,
      rgb(6 10 22 / 0.6) 0%,
      rgb(6 10 22 / 0.42) 34%,
      rgb(6 10 22 / 0.18) 68%,
      transparent 100%
    );
  }

  /* The original sky is saturated where the type sits, which is why the old hero
     used a text-shadow halo on every string. Those tokens are still in
     tokens.css, so the restored sky gets the treatment it was designed with. */
  /* Responsive scale for the foreground Boo squad, as the original hero had. */
  :global(.clawboo-boo-squad) {
    transform-origin: center bottom;
  }
  @media (max-width: 1024px) {
    :global(.clawboo-boo-squad) {
      transform: scale(0.82);
    }
  }
  @media (max-width: 768px) {
    :global(.clawboo-boo-squad) {
      transform: scale(0.62);
    }
  }
  @media (max-width: 520px) {
    :global(.clawboo-boo-squad) {
      transform: scale(0.46);
    }
  }
</style>
