---
/**
 * Runtime card: the runtime's real brand mark, its name, and one honest line.
 *
 * The "BUILT IN" / "INSTALL + CONNECT" chips are gone. They repeated what the
 * body copy already said, and a row of uppercase status pills is the kind of
 * chrome the reference sites (Notion, Tines, Deta, Railway) never use on a
 * marketing card.
 */
import RuntimeIcon from './RuntimeIcon.astro'
import type { RuntimeMarkId } from '../lib/brandMarks'

interface Props {
  id: RuntimeMarkId
  name: string
  tagline: string
  featured?: boolean
}
const { id, name, tagline, featured = false } = Astro.props
---

<div class={`rt-card card flex h-full flex-col gap-3.5 ${featured ? 'rt-featured' : ''}`}>
  <div class="flex items-center gap-3">
    <RuntimeIcon id={id} tile={38} size={19} />
    <span class="font-display text-[15px] font-semibold leading-tight tracking-[-0.012em]">
      {name}
    </span>
  </div>
  <p class="text-[14px] leading-relaxed text-secondary">{tagline}</p>
</div>

<style>
  .rt-card {
    transition:
      border-color 180ms var(--motion-easing-standard),
      transform 180ms var(--motion-easing-standard);
  }
  .rt-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--foreground) 18%, transparent);
  }
  .rt-featured {
    border-color: color-mix(in srgb, var(--primary) 32%, transparent);
  }
</style>
