---
/**
 * The runtimes we interoperate with, as a quiet strip under the hero.
 *
 * This is Notion's "Trusted by top teams" slot and Railway's integration tile
 * row, filled with the only thing we can put there honestly: a pre-traction
 * open-source project has no customer logos, but interoperating with five
 * runtimes IS the product thesis, and naming them is proof rather than
 * decoration.
 *
 * Marks come from the product's own brand map, so the site and the dashboard
 * show the identical icon for each runtime.
 */
import RuntimeIcon from './RuntimeIcon.astro'

const runtimes = [
  { id: 'clawboo-native' as const, name: 'Clawboo Native' },
  { id: 'claude-code' as const, name: 'Claude Code' },
  { id: 'codex' as const, name: 'Codex' },
  { id: 'hermes' as const, name: 'Hermes' },
  { id: 'openclaw' as const, name: 'OpenClaw' },
]
---

<div class="mt-14 sm:mt-16">
  <p class="mb-5 text-center text-[12.5px] text-secondary">
    One board. Five runtimes, as peers.
  </p>
  <ul class="tile-row">
    {
      runtimes.map((r) => (
        <li class="tile">
          <RuntimeIcon id={r.id} tile={22} size={13} />
          {r.name}
        </li>
      ))
    }
  </ul>
</div>
