---
/**
 * "Star on GitHub" CTA with a live stargazer count. The count is filled by the
 * delegated script in BaseLayout (fetches api.github.com once, caches in
 * sessionStorage, counts up, falls back gracefully). variant controls chrome.
 */
import Icon from './Icon.astro'
import { links } from '../lib/site'
import { getStarCount, formatStars } from '../lib/stars'
interface Props {
  variant?: 'pill' | 'solid'
  label?: string
  class?: string
}
const { variant = 'pill', label = 'Star', class: cls = '' } = Astro.props

// Resolved at build time so the badge always ships a number; the client script
// in BaseLayout refreshes it when GitHub answers.
const stars = formatStars(await getStarCount())
---
<a
  href={links.github}
  target="_blank"
  rel="noopener noreferrer"
  data-ph="star_click"
  class={`cb-star group inline-flex items-center gap-2 font-semibold whitespace-nowrap transition-[transform,box-shadow,border-color] duration-150 ease-out active:scale-[0.98] ${
    variant === 'solid'
      ? 'cb-star-solid h-12 rounded-xl px-6 text-[15px] text-white'
      : 'h-11 rounded-xl border px-4 text-[14px] text-foreground hover:-translate-y-px'
  } ${variant === 'pill' ? 'surface-raised-tier hover:border-[color:var(--amber)]' : ''} ${cls}`}
  aria-label="Star Clawboo on GitHub"
>
  <Icon name="star" size={16} fill class="text-amber transition-transform duration-200 group-hover:scale-110" />
  <span>{label}</span>
  <!-- Solid: no chip. The bg-white/20 wash lifted the ground under the count
       to #ed6a80, dropping white to 3.01:1; on the flat brand fill it is
       4.70:1. Pill: --amber-ink is the amber darkened for text, since --amber
       itself on its own /15 tint measures 2.67:1. -->
  <span
    data-gh-stars
    class={`font-data px-1.5 py-0.5 text-[12px] tabular-nums ${
      variant === 'solid' ? '' : 'rounded-md bg-amber/15 text-[color:var(--amber-ink)]'
    }`}>{stars}</span>
</a>

<style>
  /* Matches .cb-btn-primary: flat brand fill and a real shadow, not a coloured
     halo. The two sit side by side in the hero, so they have to agree. */
  .cb-star-solid {
    background-color: var(--brand-fill);
    box-shadow: var(--shadow-raised);
  }
  /* This element sets its own box-shadow, which replaces the global focus
     halo instead of adding to it; without this the ring is red only,
     and red on the hero sky is 1.03:1. */
  .cb-star-solid:focus-visible {
    box-shadow: var(--focus-halo), var(--shadow-raised);
  }
  .cb-star-solid:hover {
    transform: translateY(-1px);
    background-color: color-mix(in srgb, var(--brand-fill) 88%, #000);
    box-shadow: var(--shadow-floating);
  }
  /* :hover and :focus-visible are both (0,2,0), so the hover rule above wins on
     source order and takes the halo with it. A keyboard user whose pointer
     happens to rest on the button was left with the bare red outline. */
  .cb-star-solid:hover:focus-visible {
    box-shadow: var(--focus-halo), var(--shadow-floating);
  }
</style>
