---
/**
 * The connected runtimes, docked to the top-right corner of the dashboard
 * screenshot as if they are sitting on it.
 *
 * This replaces the row of tile buttons that used to sit under the hero CTAs.
 * That row put a third button style directly beneath two others, and everyone
 * already knows these logos, so the names were carrying no weight. Overlaying
 * the marks on the product says the same thing in less space and says something
 * the list could not: that these are plugged into this board.
 */
import RuntimeIcon from './RuntimeIcon.astro'
import type { RuntimeMarkId } from '../lib/brandMarks'

const runtimes: { id: RuntimeMarkId; name: string }[] = [
  { id: 'clawboo-native', name: 'Clawboo Native' },
  { id: 'claude-code', name: 'Claude Code' },
  { id: 'codex', name: 'Codex' },
  { id: 'hermes', name: 'Hermes' },
  { id: 'openclaw', name: 'OpenClaw' },
]
---

<div class="dock">
  <ul class="dock-marks">
    {
      runtimes.map((r) => (
        <li class="dock-mark" title={r.name}>
          <RuntimeIcon id={r.id} tile={34} size={18} />
          <span class="vh">{r.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .dock {
    position: absolute;
    top: 0;
    right: clamp(0.75rem, 2vw, 2rem);
    /* Perch on the frame's top edge rather than straddling its middle: the
       dashboard has its own toolbar in that corner (Team room, Brief & Rules),
       and a 46% offset landed the marks straight on top of it. Only the dock's
       lowest sliver overlaps the border, which is what makes it read as sitting
       ON the board rather than colliding with it. */
    transform: translateY(-84%);
    z-index: 2;
  }

  .dock-marks {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    border-radius: 14px;
    background: var(--surface-floating);
    border: 1px solid var(--border-floating);
    box-shadow: var(--shadow-floating);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  .dock-mark {
    display: inline-flex;
    transition: transform 200ms var(--motion-easing-spring);
  }
  .dock-mark:hover {
    transform: translateY(-2px);
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* At narrow widths the dock would cover the screenshot's own header, so it
     tucks fully inside the frame instead of straddling its edge. */
  @media (max-width: 640px) {
    .dock {
      right: 0.5rem;
      transform: translateY(-84%) scale(0.86);
      transform-origin: top right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-mark {
      transition: none;
    }
  }
</style>
