---
/**
 * The connected runtimes, perched along the dashboard's top-right edge.
 *
 * No pill, no tiles, no borders: with a container and a tinted square behind
 * each mark it read as one more button group, sitting directly above the
 * dashboard's own Team room / Brief & Rules row. Stripped to the marks alone
 * and scaled up, they read as characters sitting on the edge of the board,
 * which is the whole point.
 *
 * A soft drop-shadow does the separating instead of a background, because each
 * mark straddles two grounds: the sky above the frame and the app's white
 * header below it.
 */
import RuntimeIcon from './RuntimeIcon.astro'
import type { RuntimeMarkId } from '../lib/brandMarks'

// `lift` staggers them off the edge so the row reads as perched rather than
// ruled. Boo Zero sits highest, as it does everywhere else in the brand.
const runtimes: { id: RuntimeMarkId; name: string; lift: number }[] = [
  { id: 'openclaw', name: 'OpenClaw', lift: 2 },
  { id: 'hermes', name: 'Hermes', lift: 7 },
  { id: 'codex', name: 'Codex', lift: 0 },
  { id: 'claude-code', name: 'Claude Code', lift: 6 },
  { id: 'clawboo-native', name: 'Clawboo Native', lift: 11 },
]
---

<div class="dock">
  <ul class="dock-marks">
    {
      runtimes.map((r) => (
        <li class="dock-mark" style={`--lift:${r.lift}px`} title={r.name}>
          <RuntimeIcon id={r.id} bare size={40} />
          <span class="vh">{r.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .dock {
    position: absolute;
    top: 0;
    right: clamp(1rem, 3vw, 2.75rem);
    z-index: 2;
    pointer-events: none;
  }

  .dock-marks {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dock-mark {
    display: inline-flex;
    /* Sit ON the edge: the marks' baseline lands just below the frame's top
       border, so their lower portion overlaps the board. */
    transform: translateY(calc(-100% + 14px - var(--lift)));
    filter: drop-shadow(0 6px 14px rgb(15 23 42 / 0.22)) drop-shadow(0 1px 2px rgb(15 23 42 / 0.18));
    animation: dock-bob 6s ease-in-out infinite;
    animation-delay: calc(var(--lift) * 90ms);
  }

  :global(:root.dark) .dock-mark {
    filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.6)) drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }

  /* The same gentle idle the Boos have, so the row feels alive rather than
     pasted on. Small amplitude: this is punctuation, not the main event. */
  @keyframes dock-bob {
    0%,
    100% {
      transform: translateY(calc(-100% + 14px - var(--lift)));
    }
    50% {
      transform: translateY(calc(-100% + 10px - var(--lift)));
    }
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .dock-marks {
      gap: 0.7rem;
    }
    .dock-mark :global(svg) {
      width: 30px;
      height: 30px;
    }
  }
  @media (max-width: 560px) {
    .dock {
      right: 0.6rem;
    }
    .dock-marks {
      gap: 0.5rem;
    }
    .dock-mark :global(svg) {
      width: 23px;
      height: 23px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-mark {
      animation: none;
    }
  }
</style>
