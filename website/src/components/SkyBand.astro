---
/**
 * The sky.
 *
 * The clouds are the ORIGINAL ones: procedural SVG fractal noise (feTurbulence,
 * five octaves) in three parallax layers, at the site's locked config of
 * mood=day, clouds=0.40, definition=0.70, shading=0, glow=0. The recipe is
 * ported verbatim from the old SkyAtmosphere.tsx, which is why the texture and
 * the drift speeds match what was there before.
 *
 * What is NOT ported: React. The old version needed framer-motion only to
 * animate background-position, which CSS keyframes do for free, and the layers
 * themselves were always just data-URI backgrounds. So the texture comes back
 * at zero client-side JavaScript.
 *
 * What is kept from the rebuild: the band. The old sky filled the viewport and
 * was darkest exactly where the headline sat, so every string needed a
 * text-shadow halo. This one is saturated at the crown and pale by the time it
 * reaches the type, so the halos stay deleted.
 */
interface Props {
  class?: string
}
const { class: cls = '' } = Astro.props
---

<div class={`sky ${cls}`} aria-hidden="true">
  <div class="sky-layer sky-far"></div>
  <div class="sky-layer sky-mid"></div>
  <div class="sky-layer sky-near"></div>
  <div class="sky-grain"></div>
</div>

<style>
  :root {
    --cloud-far: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271300%27%20height%3D%27820%27%3E%3Cfilter%20id%3D%27c%27%20x%3D%270%27%20y%3D%270%27%20width%3D%27100%25%27%20height%3D%27100%25%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.0085%27%20numOctaves%3D%275%27%20seed%3D%272%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200%201%20%200%200%200%203.2199999999999998%20-1.1099999999999999%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23c%29%27%2F%3E%3C%2Fsvg%3E");
    --cloud-mid: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27960%27%20height%3D%27700%27%3E%3Cfilter%20id%3D%27c%27%20x%3D%270%27%20y%3D%270%27%20width%3D%27100%25%27%20height%3D%27100%25%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.013%27%20numOctaves%3D%275%27%20seed%3D%277%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200%201%20%200%200%200%203.2199999999999998%20-1.1099999999999999%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23c%29%27%2F%3E%3C%2Fsvg%3E");
    --cloud-near: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27700%27%20height%3D%27560%27%3E%3Cfilter%20id%3D%27c%27%20x%3D%270%27%20y%3D%270%27%20width%3D%27100%25%27%20height%3D%27100%25%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.02%27%20numOctaves%3D%275%27%20seed%3D%274%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%201%20%200%200%200%200%201%20%200%200%200%200%201%20%200%200%200%203.2199999999999998%20-1.1099999999999999%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23c%29%27%2F%3E%3C%2Fsvg%3E");
    --cloud-grain: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%3E%3Cfilter%20id%3D%27g%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.8%27%20numOctaves%3D%273%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27saturate%27%20values%3D%270%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23g%29%27%2F%3E%3C%2Fsvg%3E");
  }
  :root.dark {
    --cloud-far: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271300%27%20height%3D%27820%27%3E%3Cfilter%20id%3D%27c%27%20x%3D%270%27%20y%3D%270%27%20width%3D%27100%25%27%20height%3D%27100%25%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.0085%27%20numOctaves%3D%275%27%20seed%3D%272%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%200.02%20%200%200%200%200%200.03%20%200%200%200%200%200.07%20%200%200%200%203.2199999999999998%20-1.1099999999999999%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23c%29%27%2F%3E%3C%2Fsvg%3E");
    --cloud-mid: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27960%27%20height%3D%27700%27%3E%3Cfilter%20id%3D%27c%27%20x%3D%270%27%20y%3D%270%27%20width%3D%27100%25%27%20height%3D%27100%25%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.013%27%20numOctaves%3D%275%27%20seed%3D%277%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%200.02%20%200%200%200%200%200.03%20%200%200%200%200%200.07%20%200%200%200%203.2199999999999998%20-1.1099999999999999%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23c%29%27%2F%3E%3C%2Fsvg%3E");
    --cloud-near: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27700%27%20height%3D%27560%27%3E%3Cfilter%20id%3D%27c%27%20x%3D%270%27%20y%3D%270%27%20width%3D%27100%25%27%20height%3D%27100%25%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.02%27%20numOctaves%3D%275%27%20seed%3D%274%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%200.02%20%200%200%200%200%200.03%20%200%200%200%200%200.07%20%200%200%200%203.2199999999999998%20-1.1099999999999999%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20filter%3D%27url%28%23c%29%27%2F%3E%3C%2Fsvg%3E");
  }

  .sky {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(30rem, 26rem + 18vw, 46rem);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      var(--sky-1) 0%,
      var(--sky-2) 24%,
      var(--sky-3) 52%,
      transparent 86%
    );
  }

  .sky-layer {
    position: absolute;
    inset: 0;
    background-repeat: repeat;
    will-change: background-position;
  }

  /* Frequencies, tile sizes, blurs, opacities, masks and drift durations are the
     original layer table. Each layer travels exactly one tile width, so the loop
     is seamless. */
  .sky-far {
    background-image: var(--cloud-far);
    background-size: 1300px 820px;
    opacity: 0.232;
    filter: blur(4.85px);
    mask-image: linear-gradient(180deg, #000 0%, #000 46%, transparent 74%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 46%, transparent 74%);
    animation: drift-far 190s linear infinite;
  }
  .sky-mid {
    background-image: var(--cloud-mid);
    background-size: 960px 700px;
    opacity: 0.288;
    filter: blur(1.76px);
    mask-image: linear-gradient(180deg, transparent 4%, #000 28%, #000 64%, transparent 86%);
    -webkit-mask-image: linear-gradient(180deg, transparent 4%, #000 28%, #000 64%, transparent 86%);
    animation: drift-mid 140s linear infinite;
  }
  .sky-near {
    background-image: var(--cloud-near);
    background-size: 700px 560px;
    opacity: 0.2;
    filter: blur(0.74px);
    mask-image: linear-gradient(180deg, transparent 22%, #000 44%, #000 74%, transparent 94%);
    -webkit-mask-image: linear-gradient(180deg, transparent 22%, #000 44%, #000 74%, transparent 94%);
    animation: drift-near 95s linear infinite;
  }

  .sky-grain {
    position: absolute;
    inset: 0;
    background-image: var(--cloud-grain);
    background-size: 200px 200px;
    opacity: 0.07;
    mix-blend-mode: overlay;
  }

  @keyframes drift-far {
    to {
      background-position-x: -1300px;
    }
  }
  @keyframes drift-mid {
    to {
      background-position-x: -960px;
    }
  }
  @keyframes drift-near {
    to {
      background-position-x: -700px;
    }
  }

  /* The original stopped the drift under prefers-reduced-motion and kept the
     clouds. Same here: the texture is the point, the movement is not. */
  @media (prefers-reduced-motion: reduce) {
    .sky-layer {
      animation: none;
    }
  }
</style>
