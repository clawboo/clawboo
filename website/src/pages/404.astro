---
import BaseLayout from '../layouts/BaseLayout.astro'
import Button from '../components/Button.astro'
import SignatureSky from '../components/atmosphere/SignatureSky.astro'
import { booAvatarToDataUrl } from '../lib/boo-avatar'

// The Boo stays here: this is the one page where the mascot is the whole idea,
// and it is a generated data URL, not a photograph.
const boo = booAvatarToDataUrl({ seed: 'lost-boo', isBooZero: true })
---

<BaseLayout
  title="Page not found · Clawboo"
  description="That page drifted off. Head back home or install Clawboo with npm install -g clawboo."
  robots="noindex,follow"
>
  <section class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-5 text-center">
    <div class="pointer-events-none absolute inset-0 overflow-hidden"><SignatureSky boos={5} /></div>
    <div class="relative z-10 flex flex-col items-center">
      <img
        src={boo}
        alt="A lost Boo"
        width="88"
        height="81"
        class="clawboo-float"
        style="filter:drop-shadow(0 14px 28px rgb(var(--foreground-rgb) / 0.18))"
      />
      <p class="eyebrow mt-7">Error 404</p>
      <h1 class="d1 mt-3">This Boo drifted off.</h1>
      <p class="lead mt-4 max-w-md">
        The page you are looking for is not here. Head back home, or start a team of your own.
      </p>
      <div class="mt-8 flex flex-col items-center gap-4">
        <Button href="/" variant="primary" size="lg" iconRight="arrow-right">Back home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
