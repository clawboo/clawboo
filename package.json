{
  "name": "clawboo-root",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=20",
    "lint": "turbo lint && pnpm lint:repo",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage --coverage.reporter=text",
    "e2e": "playwright test",
    "assemble": "pnpm build && bash scripts/assemble-cli.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "catalog:build": "tsx scripts/catalog/build-index.ts && tsx scripts/catalog/build-seed.ts",
    "catalog:verify": "tsx scripts/catalog/validate.ts && tsx scripts/catalog/build-index.ts --check && tsx scripts/catalog/build-seed.ts --check",
    "verify:connectors": "tsx scripts/verify-connectors.ts",
    "check:docs": "pnpm --filter @clawboo/docs check-frontmatter",
    "test:clean-install": "node scripts/test-clean-install.mjs",
    "test:bundle-externals": "node scripts/check-bundle-externals.mjs",
    "prepublish:check": "pnpm catalog:verify && pnpm verify:connectors && pnpm assemble && pnpm test:clean-install",
    "ingest:connectors": "tsx scripts/ingest-connector-registry.ts",
    "lint:repo": "eslint scripts/ --max-warnings 0",
    "generate:brand-marks": "tsx scripts/generate-brand-marks.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "simple-icons": "^16.29.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
