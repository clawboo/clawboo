{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Clawboo",
  "description": "Free, open-source (MIT) dashboard for running a team of AI agents on your own computer.",
  "colors": {
    "primary": "#dc2a48",
    "light": "#e94560",
    "dark": "#e94560"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Cabinet Grotesk",
      "weight": 800,
      "source": "/fonts/CabinetGrotesk-Extrabold.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#f8fafc",
      "dark": "#0a0e1a"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode",
      {
        "title": "Report a problem with this page",
        "description": "Open a docs issue on GitHub with this page filled in",
        "icon": "github",
        "href": {
          "base": "https://github.com/clawboo/clawboo/issues/new",
          "query": [
            {
              "key": "template",
              "value": "docs_issue.yml"
            },
            {
              "key": "page",
              "value": "$path"
            }
          ]
        }
      }
    ]
  },
  "search": {
    "prompt": "Search the Clawboo docs"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "intro/index",
              "intro/what-is-clawboo",
              "getting-started/installation",
              "getting-started/quickstart",
              "getting-started/first-team",
              "getting-started/dashboard-tour"
            ]
          }
        ]
      },
      {
        "tab": "Use Clawboo",
        "icon": "layout-dashboard",
        "groups": [
          {
            "group": "Overview",
            "pages": ["using/index"]
          },
          {
            "group": "Build your team",
            "pages": ["using/teams", "using/marketplace", "using/agents", "using/boo-zero"]
          },
          {
            "group": "Work with your team",
            "pages": ["using/team-chat", "using/board", "using/org-chart"]
          },
          {
            "group": "Connect AI and tools",
            "pages": [
              "using/providers-and-runtimes",
              "using/connectors",
              "using/capabilities",
              "using/memory"
            ]
          },
          {
            "group": "Automate",
            "pages": ["using/routines"]
          },
          {
            "group": "Stay in control",
            "pages": ["using/approvals", "using/command-permissions", "using/budgets-and-spend"]
          },
          {
            "group": "Monitor and maintain",
            "pages": ["using/observability", "using/system-health", "using/system", "using/theming"]
          },
          {
            "group": "Recipes",
            "pages": [
